{
  "name": "valkrai-routes",
  "account_id": "f07be5f84583d0d100b05aeeae56870b",
  "compatibility_date": "2026-10-16",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "routes.valkrai.com",
      "custom_domain": true
    },
    {
      "pattern": "valkrai.com/*",
      "zone_name": "valkrai.com"
    },
    {
      "pattern": "www.valkrai.com/*",
      "zone_name": "valkrai.com"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "main": "worker.js",
  "services": [
    {
      "binding": "FLEET",
      "service": "mobley-venture-fleet-a"
    }
  ]
}
